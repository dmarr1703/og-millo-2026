# Stripe API Keys
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/test/webhooks (or `stripe listen` CLI output)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Millo owner login (set these as private environment variables in your host; never commit real values)
OWNER_EMAIL=d.marr@live.ca
OWNER_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD

# Server
PORT=3000
