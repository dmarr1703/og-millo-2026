# Supabase (select a Canadian region where available)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Millo business rules — server-side only
MILLO_CURRENCY=CAD
MILLO_LISTING_FEE_CENTS=3500
MILLO_COMMISSION_BPS=1000
MILLO_DEFAULT_COUNTRY=CA

# Stripe — secret values belong only in encrypted Vercel environment settings
STRIPE_SECRET_KEY=sk_test_REPLACE_IN_VERCEL
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_IN_VERCEL
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_VERCEL

# Owner account must be migrated to Supabase Auth; do not use a shared/demo password.
OWNER_EMAIL=owner@example.com

PORT=3000
PUBLIC_URL=http://localhost:3000
